@@ -35,7 +35,13 @@
 # raises ``TimeoutError`` mid-flow even though the mount actually succeeds.
 # 10 minutes is long enough for any realistic interactive auth ceremony
 # without leaving CI hangs unbounded.
-INTERACTIVE_AUTOMATION_TIMEOUT_SEC = 600
+# 2026-11-11 (Muse H3 mount fix): the remote drive.mount() call now runs
+# with timeout_ms=600000 (see drivemount() below). jupyter-kernel-client
+# sets a hard wall-clock deadline of monotonic() + timeout for the whole
+# execute, so the local ceiling MUST exceed the remote 600s or the local
+# side kills the mount at the same instant the remote would succeed.
+# 660s leaves a 60s margin for propagation + reply after the mount lands.
+INTERACTIVE_AUTOMATION_TIMEOUT_SEC = 660
 
 
 
